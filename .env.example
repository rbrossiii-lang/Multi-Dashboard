# ─────────────────────────────────────────────────────────────
# MultiFam Intel — environment variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# FRED (Federal Reserve Bank of St. Louis)
# Register at: https://fred.stlouisfed.org/docs/api/api_key.html
VITE_FRED_API_KEY=your_fred_api_key_here
VITE_FRED_BASE_URL=https://api.stlouisfed.org/fred

# Census Bureau API (for housing permits / construction data)
# Register at: https://api.census.gov/data/key_signup.html
VITE_CENSUS_API_KEY=your_census_api_key_here
VITE_CENSUS_BASE_URL=https://api.census.gov/data

# BLS Public Data API v2 (unemployment by metro)
# No key required for public endpoints; add if using registered access
VITE_BLS_API_KEY=your_bls_api_key_here
VITE_BLS_BASE_URL=https://api.bls.gov/publicAPI/v2

# CoStar / RealPage (vacancy & rent comps — replace with your vendor)
# Contact your data vendor for credentials
VITE_RENT_DATA_API_KEY=your_rent_data_api_key_here
VITE_RENT_DATA_BASE_URL=https://api.your-rent-data-vendor.com/v1
